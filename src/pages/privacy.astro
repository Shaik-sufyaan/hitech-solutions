---
/**
 * Privacy notice. DRAFT: describes what this website actually does today
 * (verified against the code on 2026-11-18). Hitec must have it reviewed
 * before launch and update it whenever data handling changes, e.g. when the
 * inquiry form is connected or analytics are added.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import Pending from '../components/ui/Pending.astro';
import { site } from '../content/site';

const updated = 'November 18, 2026';
---

<BaseLayout title="Privacy notice" description="How the Hitec Solutions website handles information, including the Hitec Assistant chat.">
  <PageHero
    title="Privacy notice"
    lead={`How this website handles information, including messages you send to the Hitec Assistant. Last updated ${updated}.`}
    breadcrumbs={[{ label: 'Home', href: '/' }]}
  >
    <Pending tone="dark" label="Draft notice. Hitec must review and approve it, and add its legal entity name and privacy contact, before launch." />
  </PageHero>

  <section class="section" aria-label="Privacy notice">
    <div class="container privacy">
      <nav class="privacy__toc" aria-label="On this page">
        <p class="privacy__toc-title">On this page</p>
        <ol role="list">
          <li><a href="#assistant">The Hitec Assistant chat</a></li>
          <li><a href="#forms">Employer inquiry form</a></li>
          <li><a href="#technical">Technical information</a></li>
          <li><a href="#storage">Cookies and browser storage</a></li>
          <li><a href="#providers">Service providers</a></li>
          <li><a href="#choices">Your choices</a></li>
          <li><a href="#contact">Contact and changes</a></li>
        </ol>
      </nav>

      <div class="privacy__body">
        <p class="privacy__intro">
          This notice explains what information the {site.name} website collects, how it is used, and who it is shared
          with. It covers this website only.
        </p>

        <h2 id="assistant">The Hitec Assistant chat</h2>
        <p>
          When you use the Hitec Assistant, the messages you type, and the recent messages in the same conversation, are
          sent to our website’s server so a reply can be produced.
        </p>
        <ul>
          <li>
            <strong>When AI replies are turned on,</strong> your messages are sent to Anthropic, PBC, which provides the AI
            model that writes the reply. Anthropic processes them on our behalf under its commercial terms.
          </li>
          <li>
            <strong>When AI replies are turned off,</strong> replies are produced on our server from the pages of this
            website, and your messages are not sent to anyone else.
          </li>
          <li>
            Our server does not save the content of your chat messages. To keep the conversation while you move between
            pages, it is stored in your own browser for the current session (see Cookies and browser storage).
          </li>
          <li>The assistant cannot submit requests, applications or bookings on your behalf.</li>
        </ul>
        <p>
          By continuing a chat, you agree that {site.name} and our third-party vendors may monitor, record and access chats
          to respond to you, and for quality, training, improvement and other purposes, as described in this notice.
          Please do not share sensitive personal information, such as identification numbers, health details or financial
          information, in the chat.
        </p>

        <h2 id="forms">Employer inquiry form</h2>
        <p>
          The request form on this website is not yet connected to a submission system. Information you enter there stays
          in your browser and is not sent to {site.name}. This section will be updated before the form is connected.
        </p>

        <h2 id="technical">Technical information</h2>
        <p>
          Like any website, our hosting provider receives standard technical information when you visit, such as your IP
          address, browser type and the pages requested. This is used to deliver the website, keep it secure and prevent
          abuse. The assistant uses your IP address briefly, in memory, to limit how many messages can be sent per minute.
        </p>

        <h2 id="storage">Cookies and browser storage</h2>
        <p>
          This website does not use advertising or analytics cookies, and does not load third-party tracking scripts. The
          Hitec Assistant uses your browser’s session storage to remember the current conversation and whether you
          closed the chat. Session storage is cleared when you close the browser tab, and “New chat” clears the
          conversation at any time.
        </p>

        <h2 id="providers">Service providers</h2>
        <ul>
          <li><strong>Anthropic, PBC</strong>: AI replies in the Hitec Assistant, when turned on.</li>
          <li><strong>Our website hosting provider</strong>: delivering the website and running the assistant’s server.</li>
        </ul>

        <h2 id="choices">Your choices</h2>
        <ul>
          <li>You can use this website without using the chat. Close it with the × button or the Escape key.</li>
          <li>Use “New chat” to clear the conversation stored in your browser.</li>
          <li>Avoid sharing personal or sensitive information in the chat.</li>
        </ul>

        <h2 id="contact">Contact and changes</h2>
        <p>
          We will update this notice when our handling of information changes, and change the date at the top of this
          page.
        </p>
        <Pending label="Privacy contact. Add the email or postal address people can use for privacy questions and requests." />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy {
    display: grid;
    gap: var(--space-10);
  }

  .privacy__toc {
    font-size: var(--fs-small);
  }

  .privacy__toc-title {
    font-weight: var(--fw-semibold);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .privacy__toc ol {
    margin-top: var(--space-3);
  }

  .privacy__toc li + li {
    margin-top: var(--space-2);
  }

  .privacy__toc a {
    color: var(--color-ink);
    text-decoration-color: var(--color-line-strong);
  }

  .privacy__toc a:hover {
    color: var(--color-action);
  }

  .privacy__body {
    max-width: 44rem;
  }

  .privacy__intro {
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .privacy__body h2 {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
  }

  .privacy__body p,
  .privacy__body ul {
    margin-top: var(--space-4);
    color: var(--color-ink);
  }

  .privacy__body ul {
    padding-left: 1.25rem;
  }

  .privacy__body li + li {
    margin-top: var(--space-2);
  }

  .privacy__body strong {
    font-weight: var(--fw-semibold);
  }

  .privacy__body :global(.pending) {
    margin-top: var(--space-5);
  }

  @media (min-width: 64rem) {
    .privacy {
      grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .privacy__toc {
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }
  }
</style>
