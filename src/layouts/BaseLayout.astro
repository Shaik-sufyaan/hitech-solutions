---
import '@fontsource-variable/libre-franklin';
import '../styles/global.css';
import '../styles/accents.css';
import ChatAssistant from '../components/site/ChatAssistant.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  /** Preview builds must never be indexed. Flip only for the approved production deploy. */
  noindex?: boolean;
  /** Header starts transparent over a full-bleed dark hero (home page). */
  headerOverHero?: boolean;
}

const { title, description = site.description, noindex = true, headerOverHero = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
---

<!doctype html>
<html lang="en" class:list={[headerOverHero && 'header-over-hero']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#13212e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overHero={headerOverHero} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ChatAssistant />
  </body>
</html>
