---
/**
 * Ruled index of linked items (title, short description, arrow).
 * Used for specialties and ways to hire on interior pages. Rules, not cards.
 */
import Icon from '../ui/Icon.astro';

interface Item {
  title: string;
  body: string;
  /** Omit for a plain (non-linked) entry. */
  href?: string;
}

interface Props {
  title: string;
  intro?: string;
  items: Item[];
  columns?: 2 | 3;
  id?: string;
  paper?: boolean;
}

const { title, intro, items, columns = 3, id, paper = false } = Astro.props;
const headingId = `${id ?? 'index'}-title`;
---

<section {id} class:list={['section link-index', paper && 'section--paper']} aria-labelledby={headingId}>
  <div class="container">
    <h2 id={headingId} class="t-h2 link-index__title">{title}</h2>
    {intro && <p class="t-lead t-muted link-index__intro">{intro}</p>}
    <ul role="list" class="link-index__list" style={`--cols: ${columns}`}>
      {
        items.map((item) => (
          <li>
            {item.href ? (
              <a href={item.href} class="link-index__item">
                <span class="link-index__name">
                  {item.title}
                  <Icon name="arrow-right" size={18} />
                </span>
                <span class="link-index__body">{item.body}</span>
              </a>
            ) : (
              <div class="link-index__item">
                <span class="link-index__name">{item.title}</span>
                <span class="link-index__body">{item.body}</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .link-index__title {
    max-width: 24ch;
  }

  .link-index__intro {
    max-width: 40rem;
    margin-top: var(--space-5);
  }

  .link-index__list {
    display: grid;
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-line-strong);
  }

  .link-index__list li {
    border-bottom: 1px solid var(--color-line);
  }

  .link-index__item {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6) 0;
    color: var(--color-ink);
    text-decoration: none;
  }

  .link-index__name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
  }

  .link-index__name :global(svg) {
    flex-shrink: 0;
    color: var(--color-action);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .link-index__body {
    color: var(--color-ink-muted);
    max-width: 30rem;
  }

  a.link-index__item:hover .link-index__name {
    color: var(--color-action);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .link-index__item:hover :global(svg) {
    transform: translateX(3px);
  }

  .link-index__item:focus-visible {
    outline-offset: 4px;
  }

  @media (min-width: 48rem) {
    .link-index__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-10);
    }
  }

  @media (min-width: 64rem) {
    .link-index__list {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      column-gap: var(--space-12);
    }

    .link-index__item {
      padding: var(--space-8) 0;
    }
  }
</style>
