---
/**
 * Visible marker for business input that does not exist yet. It renders in the
 * preview so reviewers can see every gap; the launch checklist requires zero
 * instances before production.
 */
interface Props {
  label: string;
  tone?: 'light' | 'dark';
  size?: 'md' | 'sm';
}
const { label, tone = 'light', size = 'md' } = Astro.props;
---

<p class:list={['pending', `pending--${tone}`, size === 'sm' && 'pending--sm']} data-pending>
  <span class="pending__tag">Pending</span>
  <span>{label}</span>
</p>

<style>
  .pending {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-control);
    font-size: var(--fs-label);
    line-height: 1.4;
    color: var(--color-ink-muted);
  }

  .pending__tag {
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }

  .pending--sm {
    gap: var(--space-2);
    padding: 0.125rem var(--space-2);
    font-size: 0.75rem;
  }

  .pending--dark {
    border-color: rgb(255 255 255 / 0.3);
    color: var(--color-on-navy-muted);
  }

  .pending--dark .pending__tag {
    color: var(--color-on-navy);
  }
</style>
