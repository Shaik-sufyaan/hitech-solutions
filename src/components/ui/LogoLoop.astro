---
/*
 * Scrolling logo strip (port of React Bits <LogoLoop />). Renders one list on the
 * server; src/scripts/logo-loop.js clones it as many times as the loop needs.
 * Each logo is either an image (`src`) or its `title` set as text.
 */
import { fadeMask } from '../../scripts/logo-loop.js';

export interface LogoItem {
  title: string;
  src?: string;
  /** Name shown beside a symbol-only image (e.g. an icon without a wordmark). */
  text?: string;
  alt?: string;
  width?: number;
  height?: number;
  href?: string;
  hoverColor?: string;
}

interface Props {
  logos: LogoItem[];
  speed?: number;
  direction?: 'left' | 'right' | 'up' | 'down';
  width?: number | string;
  logoHeight?: number;
  gap?: number;
  hoverSpeed?: number;
  pauseOnHover?: boolean;
  fadeOut?: boolean;
  fadeOutWidth?: number;
  scaleOnHover?: boolean;
  layout?: 'line' | 'wave' | 'arc' | 'orbit';
  bend?: number;
  focus?: number;
  magnify?: number;
  tiltX?: number;
  tiltY?: number;
  step?: boolean;
  muted?: number;
  labels?: 'none' | 'inline' | 'below' | 'hover';
  draggable?: boolean;
  scrollBoost?: number;
  intro?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  logos,
  direction = 'left',
  width = '100%',
  logoHeight = 28,
  gap = 32,
  fadeOut = true,
  fadeOutWidth = 0.12,
  scaleOnHover = false,
  muted = 0,
  labels = 'none',
  draggable = true,
  intro = true,
  ariaLabel = 'Partner logos',
  class: className,
  ...engineOptions
} = Astro.props;

const vertical = direction === 'up' || direction === 'down';
const amount = Math.min(1, Math.max(0, muted));
const mask = fadeOut ? fadeMask(fadeOutWidth, vertical) : undefined;
const cssWidth = typeof width === 'number' ? `${width}px` : width;

const style: Record<string, string> = {
  '--logoloop-gap': `${gap}px`,
  '--logoloop-logoHeight': `${logoHeight}px`,
};
if (!vertical || cssWidth !== '100%') style.width = cssWidth;
if (amount > 0) {
  style['--logoloop-gray'] = Math.min(1, amount * 2).toFixed(3);
  style['--logoloop-dim'] = (1 - amount * 0.6).toFixed(3);
}
if (mask) {
  style['-webkit-mask-image'] = mask;
  style['mask-image'] = mask;
}

const options = { ...engineOptions, direction, labels, draggable, intro, scaleOnHover };
---

<div
  class:list={[
    'logoloop',
    vertical ? 'logoloop--vertical' : 'logoloop--horizontal',
    scaleOnHover && 'logoloop--scale-hover',
    className,
  ]}
  style={style}
  role="region"
  aria-label={ariaLabel}
  data-logoloop={JSON.stringify(options)}
  data-intro={intro ? '' : undefined}
  data-draggable={draggable ? '' : undefined}
  data-muted={amount > 0 ? '' : undefined}
  data-labels={labels !== 'none' ? labels : undefined}
>
  <div class="logoloop__track">
    <ul class="logoloop__list" role="list">
      {
        logos.map((item) => {
          const isText = !item.src;
          const text = item.text ?? ((labels === 'inline' || labels === 'below') && !isText ? item.title : null);
          const Tag = item.href ? 'a' : 'div';
          const linkProps = item.href
            ? {
                href: item.href,
                'aria-label': (isText ? item.title : item.alt ?? item.title) || 'logo link',
                target: '_blank',
                rel: 'noreferrer noopener',
                draggable: 'false' as const,
              }
            : {};
          return (
            <li
              class="logoloop__item"
              role="listitem"
              data-color={item.hoverColor ? '' : undefined}
              data-has-text={item.src && item.text ? '' : undefined}
              style={item.hoverColor ? `--logoloop-item-color: ${item.hoverColor}` : undefined}
            >
              <Tag class="logoloop__content" {...linkProps}>
                {isText ? (
                  <span class="logoloop__node logoloop__wordmark">{item.title}</span>
                ) : (
                  <img
                    src={item.src}
                    width={item.width}
                    height={item.height}
                    alt={item.alt ?? ''}
                    title={item.title}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                )}
                {text && <span class="logoloop__label">{text}</span>}
              </Tag>
              {labels === 'hover' && item.title && (
                <span class="logoloop__tip" aria-hidden="true">
                  {item.title}
                </span>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<script>
  import { mountLogoLoop } from '../../scripts/logo-loop.js';

  document.querySelectorAll<HTMLElement>('[data-logoloop]').forEach((root) => {
    let options = {};
    try {
      options = JSON.parse(root.dataset.logoloop || '{}');
    } catch {
      /* defaults */
    }
    mountLogoLoop(root, options);
  });
</script>

<!-- Global: the engine clones list nodes at runtime. -->
<style is:global>
  .logoloop {
    --logoloop-gap: 32px;
    --logoloop-logoHeight: 28px;
    --logoloop-pad: 0px;
    position: relative;
    overflow: hidden;
    overflow: clip;
    padding-top: var(--logoloop-pad);
    padding-bottom: var(--logoloop-pad);
    -webkit-tap-highlight-color: transparent;
  }

  .logoloop--vertical {
    display: inline-block;
    height: 100%;
    padding: 0 var(--logoloop-pad);
  }

  .logoloop[data-draggable] {
    cursor: grab;
    touch-action: pan-y pinch-zoom;
  }

  .logoloop--vertical[data-draggable] {
    touch-action: pan-x pinch-zoom;
  }

  .logoloop[data-dragging],
  .logoloop[data-dragging] * {
    cursor: grabbing;
  }

  .logoloop__track {
    position: relative;
    z-index: 0;
    display: flex;
    width: max-content;
    will-change: transform;
    user-select: none;
    -webkit-user-select: none;
  }

  .logoloop--vertical .logoloop__track {
    flex-direction: column;
    width: 100%;
    height: max-content;
  }

  .logoloop__list {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logoloop--vertical .logoloop__list {
    flex-direction: column;
  }

  .logoloop__item {
    position: relative;
    flex: 0 0 auto;
    margin-right: var(--logoloop-gap);
    font-size: var(--logoloop-logoHeight);
    line-height: 1;
  }

  .logoloop--vertical .logoloop__item {
    margin-right: 0;
    margin-bottom: var(--logoloop-gap);
  }

  .logoloop[data-intro] .logoloop__item {
    opacity: 0;
  }

  .logoloop__content {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logoloop-logoHeight) * 0.3);
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
    transition:
      opacity 0.35s ease,
      filter 0.35s ease,
      color 0.35s ease;
  }

  .logoloop[data-labels='below'] .logoloop__content {
    flex-direction: column;
    gap: calc(var(--logoloop-logoHeight) * 0.22);
  }

  .logoloop__content:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .logoloop__node {
    display: inline-flex;
    align-items: center;
  }

  .logoloop__item img {
    display: block;
    width: auto;
    height: var(--logoloop-logoHeight);
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .logoloop__node,
  .logoloop__item img {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .logoloop--scale-hover .logoloop__item:hover img,
  .logoloop--scale-hover .logoloop__item:hover .logoloop__node {
    transform: scale(1.2);
  }

  .logoloop__label {
    font-size: max(12px, calc(var(--logoloop-logoHeight) * 0.5));
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .logoloop[data-labels='below'] .logoloop__label {
    font-size: max(11px, calc(var(--logoloop-logoHeight) * 0.26));
    font-weight: 500;
    letter-spacing: 0;
    opacity: 0.72;
  }

  .logoloop__tip {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: calc(var(--logoloop-logoHeight) * 0.2);
    font-size: max(11px, calc(var(--logoloop-logoHeight) * 0.26));
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    translate: -50% 4px;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      translate 0.25s ease;
  }

  .logoloop--vertical .logoloop__tip {
    top: 50%;
    left: 100%;
    margin-top: 0;
    margin-left: calc(var(--logoloop-logoHeight) * 0.25);
    translate: 4px -50%;
  }

  .logoloop__item:hover .logoloop__tip,
  .logoloop__item:focus-within .logoloop__tip,
  .logoloop__item[data-active] .logoloop__tip {
    opacity: 0.8;
    translate: -50% 0;
  }

  .logoloop--vertical .logoloop__item:hover .logoloop__tip,
  .logoloop--vertical .logoloop__item:focus-within .logoloop__tip,
  .logoloop--vertical .logoloop__item[data-active] .logoloop__tip {
    translate: 0 -50%;
  }

  .logoloop[data-muted] .logoloop__content {
    filter: grayscale(var(--logoloop-gray, 1));
    opacity: var(--logoloop-dim, 0.5);
  }

  .logoloop[data-muted] .logoloop__item:hover .logoloop__content,
  .logoloop[data-muted] .logoloop__item:focus-within .logoloop__content,
  .logoloop[data-muted] .logoloop__item[data-active] .logoloop__content {
    filter: none;
    opacity: 1;
  }

  .logoloop__item[data-color]:hover .logoloop__content,
  .logoloop__item[data-color]:focus-within .logoloop__content,
  .logoloop__item[data-color][data-active] .logoloop__content {
    color: var(--logoloop-item-color);
  }

  .logoloop:not([data-muted]) .logoloop__item:not([data-color]) a.logoloop__content:hover {
    opacity: 0.8;
  }

  /* Name set beside a symbol-only logo. */
  .logoloop__item[data-has-text] .logoloop__label {
    font-size: calc(var(--logoloop-logoHeight) * 0.66);
    font-weight: var(--fw-semibold, 600);
  }

  /* Text stand-in used until an image logo is supplied. */
  .logoloop__wordmark {
    font-size: calc(var(--logoloop-logoHeight) * 0.62);
    font-weight: var(--fw-semibold, 600);
    letter-spacing: -0.005em;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .logoloop__content,
    .logoloop__node,
    .logoloop__item img,
    .logoloop__tip {
      transition: none;
    }
  }
</style>
