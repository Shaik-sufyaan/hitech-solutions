---
/*
 * Partner programs and certifications: one compact row directly under the hero,
 * sized to sit in the first screen. LAUNCH BLOCKER: every item still needs Hitech's
 * confirmation and official badge (see content/home.ts and public/logos/README.md);
 * the visible Pending marker was removed at the user's request on 2026-11-18.
 */
import LogoLoop from '../ui/LogoLoop.astro';
import { credentials } from '../../content/home';
---

<section class="credentials" aria-labelledby="credentials-title">
  <div class="credentials__inner">
    <h2 id="credentials-title" class="credentials__label">
      {credentials.labelLines.map((line) => <span>{line}</span>)}
    </h2>
    <LogoLoop
      logos={credentials.items}
      speed={40}
      logoHeight={28}
      gap={64}
      hoverSpeed={0}
      fadeOutWidth={0.04}
      ariaLabel={credentials.label}
      class="credentials__loop"
    />
  </div>
</section>

<style>
  .credentials {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-page);
  }

  /* Label sits slightly left of the page content edge (user preference); the logos run on to the screen edge. */
  .credentials__inner {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding-left: max(var(--gutter), calc((100% - var(--container)) / 2 - 5rem));
  }

  .credentials__label {
    color: var(--color-ink-muted);
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .credentials__label span {
    display: block;
  }

  .credentials__inner :global(.credentials__loop) {
    min-width: 0;
    color: var(--color-ink);
  }

  /* Mobile: label above, logos edge to edge. */
  @media (max-width: 47.99rem) {
    .credentials__inner {
      padding-left: 0;
    }

    .credentials__label {
      padding-inline: var(--gutter);
    }
  }

  /* Small dot centred in the gap between logos. */
  .credentials__inner :global(.credentials__loop .logoloop__item::after) {
    content: '';
    position: absolute;
    top: 50%;
    right: calc(var(--logoloop-gap) / -2);
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-line-strong);
    translate: 50% -50%;
  }

  /* Optical sizing: wordmark-only logos read heavier than symbol + name at the same height. */
  .credentials__inner :global(.credentials__loop img[src$='servicenow.svg']),
  .credentials__inner :global(.credentials__loop img[src$='oracle.svg']) {
    height: calc(var(--logoloop-logoHeight) * 0.62);
  }

  .credentials__inner :global(.credentials__loop img[src$='microsoft.svg']) {
    height: calc(var(--logoloop-logoHeight) * 0.85);
  }

  .credentials__inner :global(.credentials__loop img[src$='salesforce.svg']) {
    height: calc(var(--logoloop-logoHeight) * 1.4);
  }

  /* Desktop: label and logos on one line, centred on each other. */
  @media (min-width: 48rem) {
    .credentials__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-10);
    }
  }

  /* The band takes over the top of the gap below the hero; the next section starts closer. */
  :global(.credentials + .section) {
    padding-top: clamp(3rem, 2.2rem + 2.6vw, 4.5rem);
  }
</style>
