---
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import GradientAscii from '../ui/GradientAscii.astro';
import { hero } from '../../content/home';
import { site, candidateHref } from '../../content/site';
import developer from '../../assets/images/hero-developer.jpg';
import specialist from '../../assets/images/hero-specialist.jpg';
---

<section class="hero on-navy" aria-labelledby="hero-title">
  <div class="hero__backdrop">
    <GradientAscii
      colors={['#1e3fd8', '#f6f8ff', '#a5d8ff', '#38bdf8']}
      shape="horizon"
      characters=" =+xX0S8#@"
      cellSize={18}
      density={0.8}
    />
    <div class="hero__scrim"></div>
  </div>
  <figure class="hero__photo hero__photo--left" aria-hidden="true">
    <Picture
      src={developer}
      formats={['avif', 'webp']}
      widths={[400, 640, 960, 1280]}
      sizes="(min-width: 75rem) 20vw, 100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
    />
  </figure>
  <figure class="hero__photo hero__photo--right" aria-hidden="true">
    <Picture
      src={specialist}
      formats={['avif', 'webp']}
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 75rem) 18vw, 1px"
      alt=""
      loading="eager"
    />
  </figure>

  <div class="container hero__inner">
    <h1 id="hero-title" class="t-display hero__title">
      {hero.titleLines.map((line) => <span class="hero__line">{line} </span>)}
    </h1>
    <p class="hero__body">{hero.body}</p>
    <div class="hero__actions">
      <Button href={site.requestTalentHref} variant="inverse" size="lg">{hero.primaryCta}</Button>
      <p class="hero__candidate">
        {hero.candidatePrompt}{' '}
        <a href={candidateHref}>{hero.candidateCta}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-navy);
    color: var(--color-on-navy);
  }

  /* Animated background layer; photos and copy sit above it. */
  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Keeps the copy legible over the brightest part of the glow. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(19 33 46 / 0) 0%,
      rgb(19 33 46 / 0.55) 32%,
      rgb(19 33 46 / 0.8) 55%,
      rgb(19 33 46 / 0.8) 100%
    );
  }

  .hero__photo,
  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* Home page: the hero runs up under the transparent header (see BaseLayout headerOverHero). */
  :global(html.header-over-hero) .hero {
    --hero-under-header: calc(var(--header-height) + 1px);
    margin-top: calc(-1 * var(--hero-under-header));
    padding-top: var(--hero-under-header);
  }

  /* Shade behind the nav row so its links read clearly over the brightest glyphs. */
  :global(html.header-over-hero) .hero__backdrop::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: calc(var(--header-height) * 1.9);
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(19 33 46 / 0.82) 0%,
      rgb(19 33 46 / 0.7) 45%,
      rgb(19 33 46 / 0) 100%
    );
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .hero__title {
    max-width: 16ch;
    color: var(--color-on-navy);
  }

  .hero__body {
    max-width: 36rem;
    margin-top: var(--space-5);
    color: var(--color-on-navy-muted);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .hero__candidate {
    color: var(--color-on-navy-muted);
    font-size: var(--fs-small);
  }

  .hero__candidate a {
    color: var(--color-on-navy);
    font-weight: var(--fw-semibold);
    text-decoration-color: rgb(255 255 255 / 0.5);
  }

  .hero__candidate a:hover {
    color: var(--color-on-navy-link);
    text-decoration-color: currentColor;
  }

  /* Photographs: plain rectangles, gently rounded, never masked into shapes. */
  .hero__photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-navy-raised);
  }

  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile and tablet: one working photograph leads, copy follows, CTA stays in view. */
  .hero__photo--right {
    display: none;
  }

  .hero__photo--left {
    aspect-ratio: 16 / 9;
    margin: var(--space-6) var(--gutter) 0;
  }

  .hero__photo--left :global(img) {
    object-position: 45% 40%;
    /* The source is a bright, high-key office shot; tone it down to sit on navy. */
    filter: brightness(0.64) contrast(1.18) saturate(1.1);
  }

  @media (min-width: 48rem) {
    .hero__photo--left {
      aspect-ratio: 5 / 2;
    }

    .hero__inner {
      padding-top: var(--space-12);
      padding-bottom: var(--space-20);
    }

    .hero__actions {
      flex-direction: row;
      align-items: center;
      gap: var(--space-8);
    }
  }

  /* Desktop: centred statement framed by two working photographs at the edges. */
  @media (min-width: 75rem) {
    .hero {
      min-height: 36rem;
    }

    .hero__inner {
      align-items: center;
      max-width: 54rem;
      padding-top: 6.5rem;
      padding-bottom: 7rem;
      text-align: center;
    }

    .hero__title {
      max-width: none;
    }

    .hero__line {
      display: block;
    }

    .hero__body {
      max-width: 40rem;
      margin-top: var(--space-6);
    }

    .hero__actions {
      flex-direction: column;
      gap: var(--space-5);
      margin-top: var(--space-10);
      align-items: center;
    }

    .hero__photo {
      position: absolute;
      margin: 0;
    }

    .hero__scrim {
      background: radial-gradient(
        ellipse 48rem 21rem at 50% 44%,
        rgb(19 33 46 / 0.86) 0%,
        rgb(19 33 46 / 0.7) 50%,
        rgb(19 33 46 / 0) 100%
      );
    }

    .hero__photo--left {
      left: -2.5rem;
      bottom: 4.5rem;
      width: clamp(15rem, 19vw, 19rem);
      aspect-ratio: 5 / 4;
    }

    .hero__photo--left :global(img) {
      object-position: 50% 50%;
    }

    .hero__photo--right {
      display: block;
      top: calc(3.5rem + var(--hero-under-header, 0px));
      right: -2rem;
      width: clamp(14rem, 17vw, 17rem);
      aspect-ratio: 4 / 5;
    }

    .hero__photo--right :global(img) {
      object-position: 50% 30%;
    }
  }
</style>
