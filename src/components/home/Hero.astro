---
/**
 * Home hero: three full-bleed photo slides under the transparent header
 * (user-requested 2026-11-19). Slides cross-fade every 7s; a labelled tab per
 * slide shows the time left, and there is a pause button. Rotation pauses on
 * hover, keyboard focus and a hidden tab, and never runs under reduced motion.
 */
import '@fontsource-variable/open-sans';
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import { hero } from '../../content/home';
import experience from '../../assets/images/hero-slide-experience.jpg';
import specialists from '../../assets/images/hero-slide-specialists.jpg';
import hiring from '../../assets/images/hero-slide-hiring.jpg';

const photos = { experience, specialists, hiring } as const;
const count = hero.slides.length;

/** '**Bold** light|next line' → lines of { text, bold } runs (see home.ts). */
const titleLines = (title: string) =>
  title.split('|').map((line) =>
    line
      .split(/(\*\*.+?\*\*)/)
      .filter(Boolean)
      .map((run) => (run.startsWith('**') ? { text: run.slice(2, -2), bold: true } : { text: run, bold: false })),
  );
---

<section
  class="hero"
  aria-roledescription="carousel"
  aria-label={hero.label}
  data-hero
>
  <div class="hero__slides" aria-live="off" data-hero-live>
    {
      hero.slides.map((slide, i) => (
        <div
          class:list={['hero__slide', `hero__slide--${slide.id}`, i === 0 && 'is-active']}
          id={`hero-slide-${slide.id}`}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${count}`}
          inert={i !== 0}
          data-hero-slide
        >
          <Picture
            class="hero__img"
            src={photos[slide.photo as keyof typeof photos]}
            formats={['avif', 'webp']}
            widths={[1641]}
            sizes="1641px"
            quality={90}
            alt={slide.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
          <div class="hero__shade" aria-hidden="true"></div>
          <div class="container hero__copy">
            {(() => {
              const Tag = i === 0 ? 'h1' : 'h2';
              return (
                <Tag class="hero__title">
                  {titleLines(slide.title).map((runs) => (
                    <>
                      <span class="hero__line">
                        {runs.map((run) => (run.bold ? <b>{run.text}</b> : run.text))}
                      </span>{' '}
                    </>
                  ))}
                </Tag>
              );
            })()}
            <p class="hero__body">{slide.body}</p>
            <Button href={slide.cta.href} variant="inverse" size="lg" class="hero__cta">
              {slide.cta.label}
            </Button>
          </div>
        </div>
      ))
    }
  </div>

  <div class="container hero__controls">
    <button type="button" class="hero__pause" aria-label="Pause slideshow" data-hero-pause>
      <svg class="hero__pause-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5v14M16 5v14" />
      </svg>
      <svg class="hero__play-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 4.5v15L19 12z" />
      </svg>
    </button>
    <ul role="list" class="hero__tabs">
      {
        hero.slides.map((slide, i) => (
          <li>
            <button
              type="button"
              class="hero__tab"
              aria-controls={`hero-slide-${slide.id}`}
              aria-current={i === 0 ? 'true' : undefined}
              data-hero-tab
            >
              <span class="visually-hidden">Slide {i + 1}: </span>
              <span class="hero__tab-label">{slide.tab}</span>
              <span class="hero__track" aria-hidden="true">
                <span class="hero__fill" data-hero-fill />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero]');

  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-hero-tab]')];
    const fills = [...root.querySelectorAll<HTMLElement>('[data-hero-fill]')];
    const live = root.querySelector<HTMLElement>('[data-hero-live]');
    const pause = root.querySelector<HTMLButtonElement>('[data-hero-pause]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let stopped = still.matches; // the visitor's own pause, or reduced motion

    const sync = () => {
      root.classList.toggle('is-stopped', stopped);
      pause?.setAttribute('aria-label', stopped ? 'Play slideshow' : 'Pause slideshow');
      // Announce slide changes only once the visitor is in control.
      live?.setAttribute('aria-live', stopped ? 'polite' : 'off');
    };

    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const on = i === current;
        slide.classList.toggle('is-active', on);
        slide.inert = !on;
      });
      tabs.forEach((tab, i) => {
        if (i === current) tab.setAttribute('aria-current', 'true');
        else tab.removeAttribute('aria-current');
      });
      // Restart the active tab's countdown from zero.
      fills.forEach((fill) => fill.classList.remove('is-running'));
      void fills[current]?.offsetWidth;
      fills[current]?.classList.add('is-running');
    };

    // The tab's progress bar is the timer: when it fills, move on.
    fills.forEach((fill) =>
      fill.addEventListener('animationend', () => {
        if (!stopped) show(current + 1);
      }),
    );

    tabs.forEach((tab, i) => tab.addEventListener('click', () => show(i)));

    pause?.addEventListener('click', () => {
      stopped = !stopped;
      sync();
      if (!stopped) show(current); // resume with a full interval on the slide in view
    });

    // Hidden tab: hold the countdown so the visitor returns to the slide they left.
    document.addEventListener('visibilitychange', () => {
      root.classList.toggle('is-hidden', document.hidden);
    });

    still.addEventListener('change', (event) => {
      if (event.matches) {
        stopped = true;
        sync();
      }
    });

    sync();
    show(0);
  }
</script>

<style>
  .hero {
    --hero-interval: 7s;
    --hero-shade: 19 33 46; /* navy, as RGB channels for the legibility scrims */
    /* Everything above the hero: top bar, navigation row and its 1px rule. */
    --hero-under-header: calc(var(--utility-height) + var(--header-height) + 1px);
    position: relative;
    display: grid;
    overflow: hidden;
    margin-top: calc(-1 * var(--hero-under-header));
    min-height: clamp(36rem, 100svh, 52rem);
    background: var(--color-navy);
    color: var(--color-on-navy);
    isolation: isolate;
  }

  .hero__slides {
    display: grid;
    grid-area: 1 / 1;
  }

  /* All slides share one cell, so the hero is as tall as its longest copy. */
  .hero__slide {
    position: relative;
    display: grid;
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 900ms var(--ease-out),
      visibility 0s linear 900ms;
  }

  .hero__slide.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 900ms var(--ease-out),
      visibility 0s;
  }

  /*
   * Phones: the photo fills the top of the hero and fades into navy behind the copy.
   * Covering the whole tall screen would zoom the wide 1641x640 source ~4x; this keeps it near 2x.
   */
  .hero__slide :global(picture),
  .hero__shade {
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(18rem, 58svh, 32rem);
  }

  .hero__slide :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Phones: subject at the top, copy over a navy fade at the foot. */
  .hero__slide--experience :global(.hero__img) { object-position: 74% 50%; }
  .hero__slide--specialists :global(.hero__img) { object-position: 48% 50%; }
  .hero__slide--hiring :global(.hero__img) { object-position: 52% 50%; }

  .hero__shade {
    background:
      linear-gradient(to bottom, rgb(var(--hero-shade) / 0.72) 0, rgb(var(--hero-shade) / 0) 11rem),
      linear-gradient(
        to top,
        rgb(var(--hero-shade) / 1) 0%,
        rgb(var(--hero-shade) / 0.86) 20%,
        rgb(var(--hero-shade) / 0.3) 45%,
        rgb(var(--hero-shade) / 0) 62%
      );
  }

  .hero__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    width: 100%;
    padding-top: calc(var(--hero-under-header) + var(--space-16));
    /* Room for the slide controls underneath. */
    padding-bottom: calc(var(--space-20) + var(--space-8));
  }

  /* Open Sans, Light with Bold key phrases (user's reference, 2026-11-19). Hero only. */
  .hero__title,
  .hero__body {
    font-family: 'Open Sans Variable', 'Open Sans', 'Segoe UI', system-ui, sans-serif;
  }

  .hero__title {
    max-width: 19ch;
    color: #fff;
    font-size: clamp(2.125rem, 1.2rem + 2.7vw, 3.75rem);
    font-weight: 300;
    line-height: 1.16;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .hero__title b {
    font-weight: 700;
    letter-spacing: -0.018em;
  }

  .hero__body {
    max-width: 34rem;
    margin-top: var(--space-6);
    color: #fff;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    font-weight: 400;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero__copy :global(.hero__cta) {
    margin-top: var(--space-8);
  }

  /* The incoming slide's copy settles into place as the photo fades in. */
  .hero__title,
  .hero__body,
  .hero__copy :global(.hero__cta) {
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity 700ms var(--ease-out),
      translate 700ms var(--ease-out);
  }

  .is-active .hero__title,
  .is-active .hero__body,
  .is-active :global(.hero__cta) {
    opacity: 1;
    translate: 0 0;
  }

  .is-active .hero__title { transition-delay: 150ms; }
  .is-active .hero__body { transition-delay: 250ms; }
  .is-active :global(.hero__cta) { transition-delay: 350ms; }

  /* ---------- Controls: pause, then one labelled countdown per slide ---------- */
  .hero__controls {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: var(--space-5);
    grid-area: 1 / 1;
    align-self: end;
    width: 100%;
    padding-bottom: var(--space-8);
  }

  .hero__pause {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: var(--radius-control);
    background: rgb(var(--hero-shade) / 0.35);
    color: #fff;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .hero__pause:hover {
    border-color: #fff;
    background: #fff;
    color: var(--color-navy);
  }

  .hero__pause svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .hero__pause-icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
  }

  .hero__play-icon path {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .hero__play-icon,
  .is-stopped .hero__pause-icon {
    display: none;
  }

  .is-stopped .hero__play-icon {
    display: block;
  }

  .hero__tabs {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: 33rem;
  }

  .hero__tab {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    min-height: 2.75rem;
    justify-content: flex-end;
    padding: 0;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.72);
    font: inherit;
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .hero__tab:hover,
  .hero__tab[aria-current='true'] {
    color: #fff;
  }

  .hero__tab-label {
    white-space: nowrap;
  }

  /* Smallest phones: the three labels need a little less room. */
  @media (max-width: 23.99rem) {
    .hero__controls,
    .hero__tabs {
      gap: var(--space-3);
    }

    .hero__tab {
      font-size: 0.8125rem;
    }
  }

  .hero__track {
    position: relative;
    display: block;
    height: 3px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.3);
  }

  .hero__fill {
    position: absolute;
    inset: 0;
    background: var(--color-amber);
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero__fill.is-running {
    animation: hero-countdown var(--hero-interval) linear forwards;
  }

  /* Hover, keyboard focus, a hidden tab or the pause button all hold the countdown. */
  .hero:has(:focus-visible) .hero__fill,
  .hero.is-hidden .hero__fill {
    animation-play-state: paused;
  }

  /* Mouse only: on touch screens :hover sticks after a tap and would stall the slides. */
  @media (hover: hover) {
    .hero:hover .hero__fill {
      animation-play-state: paused;
    }
  }

  /* Stopped (paused or reduced motion): the current slide's bar reads as fully selected. */
  .hero.is-stopped .hero__fill {
    animation: none;
  }

  .hero.is-stopped .hero__tab[aria-current='true'] .hero__fill {
    transform: none;
  }

  @keyframes hero-countdown {
    to {
      transform: scaleX(1);
    }
  }

  .hero :focus-visible {
    outline-color: var(--color-focus-on-navy);
  }

  /* ---------- Tablet and up: copy on the left over a sideways fade ---------- */
  @media (min-width: 48rem) {
    .hero {
      min-height: clamp(36rem, calc(100svh - var(--credentials-height)), 54rem);
    }

    .hero__slide :global(picture),
    .hero__shade {
      inset: 0;
      height: auto;
    }

    .hero__slide--experience :global(.hero__img) { object-position: 100% 50%; }
    .hero__slide--specialists :global(.hero__img) { object-position: 30% 50%; }
    .hero__slide--hiring :global(.hero__img) { object-position: 40% 50%; }

    .hero__shade {
      background:
        linear-gradient(to bottom, rgb(var(--hero-shade) / 0.7) 0, rgb(var(--hero-shade) / 0) 12rem),
        linear-gradient(to top, rgb(var(--hero-shade) / 0.6) 0, rgb(var(--hero-shade) / 0) 11rem),
        linear-gradient(
          to right,
          rgb(var(--hero-shade) / 0.9) 0%,
          rgb(var(--hero-shade) / 0.74) 32%,
          rgb(var(--hero-shade) / 0.28) 56%,
          rgb(var(--hero-shade) / 0) 72%
        );
    }

    .hero__copy {
      justify-content: center;
      padding-top: calc(var(--hero-under-header) + var(--space-12));
      padding-bottom: calc(var(--space-20) + var(--space-10));
    }

    .hero__body {
      margin-top: var(--space-6);
    }

    .hero__controls {
      padding-bottom: var(--space-10);
    }
  }

  /* Tablet and up: the authored line breaks (bold / light / bold), as in the reference. */
  @media (min-width: 48rem) {
    .hero__title {
      max-width: none;
    }

    .hero__line {
      display: block;
    }
  }

  /* Phones held sideways: no room for the countdown labels above the bars. */
  @media (max-height: 30rem) and (orientation: landscape) {
    .hero {
      min-height: 100svh;
    }

    .hero__copy {
      padding-top: calc(var(--hero-under-header) + var(--space-6));
      padding-bottom: calc(var(--space-16) + var(--space-4));
    }

    .hero__body {
      display: none;
    }

    .hero__copy :global(.hero__cta) {
      margin-top: var(--space-5);
    }

    .hero__controls {
      padding-bottom: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide,
    .hero__slide.is-active,
    .hero__title,
    .hero__body,
    .hero__copy :global(.hero__cta) {
      transition: none;
      translate: none;
    }
  }
</style>
