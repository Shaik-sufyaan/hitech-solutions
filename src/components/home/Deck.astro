---
/*
 * Stacking deck (home page): Specialties, Ways to hire and Process as three
 * professionally dark panels. On desktop with motion allowed, each panel pins
 * (CSS sticky on native scroll) while the next slides over it, and the covered
 * panel dims. On mobile or with reduced motion they are ordinary sections.
 */
import Specialties from './Specialties.astro';
import Engagement from './Engagement.astro';
import Process from './Process.astro';
---

<div class="deck" data-deck>
  <div class="deck__panel tone-dark" data-deck-panel>
    <Specialties />
  </div>
  <div class="deck__panel tone-dark tone-steel" data-deck-panel>
    <Engagement />
  </div>
  <div class="deck__panel tone-dark tone-teal" data-deck-panel>
    <Process paper={false} />
  </div>
</div>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  const panels = [...(deck?.querySelectorAll<HTMLElement>('[data-deck-panel]') ?? [])];
  const header = document.querySelector<HTMLElement>('[data-header]');
  const active = window.matchMedia('(min-width: 64rem) and (prefers-reduced-motion: no-preference)');

  let queued = false;

  // A panel taller than the screen pins only once its bottom is reached, so nothing is ever hidden.
  const layout = () => {
    const headerHeight = header?.offsetHeight ?? 0;
    for (const panel of panels) {
      if (!active.matches) {
        panel.style.removeProperty('--deck-top');
        continue;
      }
      const top = Math.min(headerHeight, window.innerHeight - panel.offsetHeight);
      panel.style.setProperty('--deck-top', `${Math.round(top)}px`);
    }
    paint();
  };

  // Dim each panel in proportion to how far the next one has slid over it.
  const paint = () => {
    queued = false;
    const headerHeight = header?.offsetHeight ?? 0;
    const travel = Math.max(1, window.innerHeight - headerHeight);
    panels.forEach((panel, index) => {
      const next = panels[index + 1];
      if (!active.matches || !next) {
        panel.style.removeProperty('--cover');
        return;
      }
      const covered = (window.innerHeight - next.getBoundingClientRect().top) / travel;
      panel.style.setProperty('--cover', Math.min(1, Math.max(0, covered)).toFixed(3));
    });
  };

  if (deck && panels.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(paint);
        }
      },
      { passive: true },
    );
    new ResizeObserver(layout).observe(deck);
    window.addEventListener('resize', layout);
    active.addEventListener('change', layout);
    layout();
  }
</script>

<style>
  /* Dark-panel adjustments for components designed on light surfaces. */
  .deck :global(.step__number) {
    border-color: var(--color-amber);
    background: transparent;
    color: var(--color-on-navy);
  }

  .deck :global(.process__photo) {
    background: rgb(255 255 255 / 0.06);
  }

  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .deck__panel {
      position: sticky;
      top: var(--deck-top, var(--header-height));
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100svh - var(--header-height));
    }

    /* The incoming panel casts a soft shadow onto the one it covers. */
    .deck__panel + .deck__panel {
      box-shadow: 0 -18px 40px -12px rgb(4 10 17 / 0.55);
      clip-path: inset(-96px 0 -2px 0); /* shadow falls upward only, never onto the next section */
    }

    /* Subpixel seam guard: the last panel paints 2px past its edge so covered panels never peek through. */
    .deck__panel:last-child::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -2px;
      height: 2px;
      background: var(--tone-bg);
    }

    .deck__panel::after {
      content: '';
      position: absolute;
      inset: 0;
      background: #050b12;
      opacity: calc(var(--cover, 0) * 0.6);
      pointer-events: none;
    }
  }
</style>
