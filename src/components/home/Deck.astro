---
/*
 * Stacking deck (home page): Specialties, Ways to hire and Process as three
 * black sheets (local contrast preview requested by the user).
 * On desktop with motion allowed, each sheet is an inset card on a
 * white background; it pins (CSS sticky on native scroll) a little lower than
 * the one before so every covered sheet keeps a visible top edge, and the covered
 * sheet shrinks and dims slightly as the next arrives. On mobile or with reduced
 * motion they are ordinary full-width sections.
 */
import Specialties from './Specialties.astro';
import Engagement from './Engagement.astro';
import Process from './Process.astro';
---

<div class="deck" data-deck>
  <div class="deck__panel deck__panel--paper" data-deck-panel>
    <Specialties />
  </div>
  <div class="deck__panel" data-deck-panel>
    <Engagement />
  </div>
  <div class="deck__panel deck__panel--paper" data-deck-panel>
    <Process />
  </div>
</div>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  const panels = [...(deck?.querySelectorAll<HTMLElement>('[data-deck-panel]') ?? [])];
  const header = document.querySelector<HTMLElement>('[data-header]');
  const active = window.matchMedia('(min-width: 64rem) and (prefers-reduced-motion: no-preference)');

  const GAP = 16; // space between the header and the first sheet
  const PEEK = 14; // each later sheet pins this much lower, leaving the edge above it visible
  const BOTTOM = 16; // breathing room under a sheet taller than the screen

  let queued = false;

  // Sheets pin in a staircase; one taller than the screen pins only once its bottom is reached.
  const layout = () => {
    const headerHeight = header?.offsetHeight ?? 0;
    panels.forEach((panel, index) => {
      if (!active.matches) {
        panel.style.removeProperty('--deck-top');
        return;
      }
      const stair = headerHeight + GAP + index * PEEK;
      const top = Math.min(stair, window.innerHeight - panel.offsetHeight - BOTTOM);
      panel.style.setProperty('--deck-top', `${Math.round(top)}px`);
    });
    paint();
  };

  // Shrink and dim each sheet in proportion to how far the next one has slid over it.
  const paint = () => {
    queued = false;
    const headerHeight = header?.offsetHeight ?? 0;
    const travel = Math.max(1, window.innerHeight - headerHeight - GAP);
    panels.forEach((panel, index) => {
      const next = panels[index + 1];
      if (!active.matches || !next) {
        panel.style.removeProperty('--cover');
        return;
      }
      const covered = (window.innerHeight - next.getBoundingClientRect().top) / travel;
      panel.style.setProperty('--cover', Math.min(1, Math.max(0, covered)).toFixed(3));
    });
  };

  if (deck && panels.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(paint);
        }
      },
      { passive: true },
    );
    new ResizeObserver(layout).observe(deck);
    window.addEventListener('resize', layout);
    active.addEventListener('change', layout);
    layout();
  }
</script>

<style>
  .deck {
    --color-ink: #ffffff;
    --color-ink-muted: #c4c4c4;
    --color-page: #000000;
    --color-paper: #000000;
    --color-line: #303030;
    --color-line-strong: #606060;
    --color-action: var(--color-amber);
    --color-action-hover: var(--color-amber-hover);
    --color-focus: #ffffff;
    --color-deck-bed: #ffffff;
    color: var(--color-ink);
    background: var(--color-deck-bed);
  }

  .deck :global(.step__number) {
    color: var(--color-amber);
    border-color: var(--color-amber);
  }

  .deck :global(.model .t-h3) {
    color: var(--color-amber);
  }

  .deck :global(.btn--primary) {
    background: #ffffff;
    color: #000000;
  }

  .deck :global(.btn--primary:hover) {
    background: #dedede;
    color: #000000;
  }

  /* Sheets are opaque so the one underneath never shows through. */
  .deck__panel {
    --tone-bg: var(--color-page);
    background: var(--tone-bg);
  }

  .deck__panel--paper {
    --tone-bg: var(--color-paper);
  }

  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    /* White surround contrasts with the black inset sheets. */
    .deck {
      padding: var(--space-4) var(--deck-inset) var(--space-8);
      background: var(--color-deck-bed);
      --deck-inset: clamp(0.75rem, 1.6vw, 1.75rem);
    }

    .deck__panel {
      position: sticky;
      top: var(--deck-top, var(--header-height));
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100svh - var(--header-height) - 4rem);
      overflow: clip;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-sheet);
      box-shadow:
        0 -14px 32px -18px rgb(19 33 46 / 0.28),
        0 1px 2px rgb(19 33 46 / 0.06);
      transform: scale(calc(1 - var(--cover, 0) * 0.04));
      transform-origin: 50% 0;
    }

    .deck__panel + .deck__panel {
      margin-top: var(--space-4);
    }

    /* Inside a sheet, sections breathe a little less than full-bleed bands, and less
       again on short screens so each sheet can pin below the header with its edge showing. */
    .deck__panel > :global(.section) {
      padding-block: clamp(2rem, 8vh - 1.25rem, 4.75rem);
    }

    .deck__panel :global(.engagement__models),
    .deck__panel :global(.specialties__list) {
      margin-top: clamp(1.5rem, 5vh - 0.5rem, 3rem);
    }

    .deck__panel::after {
      content: '';
      position: absolute;
      inset: 0;
      background: #000000;
      opacity: calc(var(--cover, 0) * 0.1);
      pointer-events: none;
    }
  }
</style>
