---
import { glance } from '../../content/home';
---

<section class="section glance" aria-labelledby="glance-title" aria-describedby="glance-note">
  <div class="container">
    <div class="glance__overview">
      <h2 id="glance-title" class="t-h2">{glance.title}</h2>
      <dl class="glance__highlights">
        {glance.cards.map((card) => (
          <div class="glance__highlight">
            <dt>{card.label}</dt>
            <dd class:list={['glance__number', { 'is-empty': card.value === null }]}>
              {card.value ?? 'Pending'}
            </dd>
          </div>
        ))}
      </dl>
    </div>
    <dl class="glance__metrics">
      {glance.rings.map((metric) => (
        <div class="glance__metric">
          <dt>{metric.label}</dt>
          <dd class:list={['glance__percentage', { 'is-empty': metric.value === null }]}>
            {metric.value === null ? 'Pending' : <>{metric.value}<span>%</span></>}
          </dd>
        </div>
      ))}
    </dl>
    <p id="glance-note" class="glance__note">
      <strong>Values to be confirmed.</strong>
      {glance.pending}
    </p>
  </div>
</section>

<style>
  .glance__overview {
    display: grid;
    gap: 2.5rem;
    padding-bottom: clamp(2.5rem, 4vw, 4rem);
  }
  .glance h2 { max-width: 24rem; }
  .glance__highlights { display: grid; gap: 2rem; }
  .glance__highlight, .glance__metric {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .glance dt {
    max-width: 16rem;
    color: var(--color-ink-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .glance__number, .glance__percentage {
    order: -1;
    margin-bottom: 1rem;
    color: var(--color-navy);
    font-weight: 400;
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: -0.055em;
    line-height: 1;
  }
  .glance__number { font-size: clamp(3.25rem, 4.8vw, 4.75rem); }
  .glance__metrics {
    display: grid;
    background: var(--color-paper);
    padding: clamp(1.5rem, 3vw, 2.75rem);
    gap: 1.75rem;
  }
  .glance__metric + .glance__metric {
    border-top: 1px solid var(--color-line);
    padding-top: 1.75rem;
  }
  .glance__percentage {
    color: var(--color-navy);
    font-size: clamp(2.75rem, 3.8vw, 3.75rem);
    margin-bottom: 0.75rem;
    white-space: nowrap;
  }
  .glance__percentage span {
    font-size: 0.5em;
    margin-left: 0.12em;
    letter-spacing: -0.02em;
  }
  .glance__metric dt { color: var(--color-ink); font-weight: 500; }
  .glance__note {
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-amber);
    color: var(--color-ink-muted);
    font-size: 0.8125rem;
    line-height: 1.65;
    max-width: 53rem;
  }
  .glance__note strong {
    color: var(--color-ink);
    font-weight: 600;
    margin-right: 0.4em;
  }
  .glance .is-empty { font-size: 1.5rem; letter-spacing: 0; }
  @media (min-width: 40rem) {
    .glance__highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
    .glance__metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
    .glance__metric + .glance__metric {
      border-top: 0;
      padding-top: 0;
      border-left: 1px solid var(--color-line);
      padding-left: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .glance__overview {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
  }
</style>
