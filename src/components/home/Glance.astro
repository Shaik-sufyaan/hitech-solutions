---
/*
 * "At a glance" figures. Every value is PENDING (null renders as an em dash)
 * until Hitech supplies verified numbers in content/home.ts.
 */
import Pending from '../ui/Pending.astro';
import { glance } from '../../content/home';

const RADIUS = 52;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const arc = (value: number | null) =>
  value === null ? 0 : (Math.min(100, Math.max(0, value)) / 100) * CIRCUMFERENCE;
---

<section class="section glance" aria-labelledby="glance-title">
  <div class="container">
    <div class="glance__top">
      <div class="glance__head">
        <h2 id="glance-title" class="t-h2">{glance.title}</h2>
        <Pending label={glance.pending} />
      </div>

      <ul role="list" class="glance__cards">
        {
          glance.cards.map((card) => (
            <li class="stat-card">
              <p class="stat-card__value">{card.value ?? <span class="is-empty">Pending</span>}</p>
              <p class="stat-card__label">{card.label}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <ul role="list" class="glance__rings">
      {
        glance.rings.map((ring) => (
          <li class="ring">
            <div class="ring__figure">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <circle class="ring__track" cx="60" cy="60" r={RADIUS} />
                {ring.value !== null && (
                  <circle
                    class="ring__arc"
                    cx="60"
                    cy="60"
                    r={RADIUS}
                    stroke-dasharray={`${arc(ring.value).toFixed(2)} ${CIRCUMFERENCE.toFixed(2)}`}
                  />
                )}
              </svg>
              <p class="ring__value">
                {ring.value === null ? <span class="is-empty">Pending</span> : <>{ring.value}<span>%</span></>}
              </p>
            </div>
            <p class="ring__label">{ring.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .glance__top {
    display: grid;
    gap: var(--space-10);
  }

  .glance__head {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: start;
  }

  .glance__cards {
    display: grid;
    gap: var(--space-6);
  }

  /* Amber cap marks each figure; the card itself stays flat. */
  .stat-card {
    display: grid;
    align-content: start;
    padding: var(--space-8);
    border: 1px solid var(--color-line);
    border-top: 6px solid var(--color-amber);
    border-radius: var(--radius-media);
    background: var(--color-page);
  }

  .stat-card__value {
    color: var(--color-ink);
    font-size: clamp(2.25rem, 1.8rem + 1.4vw, 3rem);
    font-weight: var(--fw-light);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .stat-card__label {
    margin-top: var(--space-1);
    color: var(--color-ink-muted);
    font-size: var(--fs-small);
  }

  .glance__rings {
    display: grid;
    gap: var(--space-10);
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-line);
  }

  .ring {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .ring__figure {
    position: relative;
    width: 10rem;
    aspect-ratio: 1;
  }

  .ring__figure svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .ring__track,
  .ring__arc {
    fill: none;
    stroke-width: 8;
  }

  .ring__track {
    stroke: var(--color-line);
  }

  .ring__arc {
    stroke: var(--color-teal);
  }

  .ring__value {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-ink);
    font-size: 2.75rem;
    font-weight: var(--fw-light);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .ring__value span:not(.is-empty) {
    font-size: 0.55em;
  }

  /* Pending figure: says so in words (readable, announced), never a fake value. */
  .is-empty {
    color: var(--color-ink-muted);
    font-size: 1.125rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0;
  }

  .ring__label {
    max-width: 16rem;
    color: var(--color-ink);
    font-weight: var(--fw-medium);
  }

  @media (min-width: 40rem) {
    .glance__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .glance__rings {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .glance__top {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
  }
</style>
