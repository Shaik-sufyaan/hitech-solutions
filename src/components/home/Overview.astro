---
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { overview } from '../../content/home';
import { routes } from '../../content/navigation';
import collaboration from '../../assets/images/overview-collaboration.jpg';
import { getPhoto } from '../../content/photography';

interface Props {
  paper?: boolean;
  showLink?: boolean;
  photoKey?: string;
}
const { paper = false, showLink = true, photoKey } = Astro.props;
const photo = photoKey ? getPhoto(photoKey) : null;
---

<section id="hire" class:list={['section overview', paper && 'section--paper']} aria-labelledby="overview-title">
  <div class="container overview__grid">
    <div class="overview__copy">
      <h2 id="overview-title" class="t-h2">{overview.title}</h2>
      <div class="prose overview__intro">
        {overview.paragraphs.map((p) => <p class="t-lead">{p}</p>)}
      </div>

      <h3 class="overview__points-title">{overview.pointsTitle}</h3>
      <ul role="list" class="overview__points">
        {
          overview.points.map((point) => (
            <li>
              <span class="overview__check">
                <Icon name="check" size={20} />
              </span>
              <div>
                <p class="overview__point-title">{point.title}</p>
                <p class="overview__point-body">{point.body}</p>
              </div>
            </li>
          ))
        }
      </ul>

      {
        showLink && (
          <a class="arrow-link overview__link" href={routes.howWeWork}>
            {overview.linkLabel}
            <Icon name="arrow-right" />
          </a>
        )
      }
    </div>

    <figure class="overview__photo">
      <Picture
        src={photo?.image ?? collaboration}
        formats={['avif', 'webp']}
        widths={[400, 640, 900, 1200]}
        sizes="(min-width: 64rem) 40vw, 100vw"
        alt={photo?.alt ?? 'Two colleagues discussing work on a laptop at a shared desk.'}
      />
    </figure>
  </div>
</section>

<style>
  .overview__grid {
    display: grid;
    gap: var(--space-12);
  }

  .overview__intro {
    margin-top: var(--space-6);
    color: var(--color-ink);
  }

  .overview__points-title {
    margin-top: var(--space-12);
    font-size: 1.0625rem;
    font-weight: var(--fw-semibold);
  }

  .overview__points {
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .overview__points li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-line);
  }

  .overview__check {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05rem;
    color: var(--color-action);
  }

  .overview__point-title {
    font-weight: var(--fw-semibold);
  }

  .overview__point-body {
    margin-top: var(--space-1);
    color: var(--color-ink-muted);
    max-width: 34rem;
  }

  .overview__link {
    margin-top: var(--space-8);
  }

  .overview__photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-media);
    aspect-ratio: 4 / 3;
    background: var(--color-paper);
  }

  .overview__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  @media (min-width: 64rem) {
    .overview__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .overview__photo {
      aspect-ratio: 4 / 5;
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }
  }
</style>
