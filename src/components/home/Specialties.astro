---
/*
 * Home-page specialties, distilled (2026-11-18): six specialties as single
 * clickable rows (name, one line, arrow). Example roles live on each
 * specialty page, so the home page no longer repeats them.
 */
import Icon from '../ui/Icon.astro';
import Pending from '../ui/Pending.astro';
import { specialties } from '../../content/home';
import { site } from '../../content/site';
import { specialtyHref, routes } from '../../content/navigation';
---

<section id="specialties" class="section section--paper specialties" aria-labelledby="specialties-title">
  <div class="container">
    <div class="specialties__head">
      <h2 id="specialties-title" class="t-h2">{specialties.title}</h2>
      <div class="specialties__intro">
        <p class="t-lead t-muted">{specialties.intro}</p>
        <Pending label={specialties.pending} />
      </div>
    </div>

    <ul role="list" class="specialties__list">
      {
        specialties.groups.map((group) => (
          <li>
            <a class="specialty" href={specialtyHref(group.title)}>
              <span class="specialty__text">
                <span class="specialty__title">{group.title}</span>
                <span class="specialty__body">{group.body}</span>
              </span>
              <Icon name="arrow-right" class="specialty__arrow" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="specialties__links">
      <a class="arrow-link" href={routes.specialties}>
        View all specialties and roles
        <Icon name="arrow-right" />
      </a>
      <a class="arrow-link" href={site.requestTalentHref}>
        {specialties.ctaLabel}
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<style>
  .specialties__head {
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
  }

  .specialties__intro {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .specialties__list {
    display: grid;
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-line-strong);
  }

  /* Whole row is the link: name, one line, arrow. */
  .specialty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: 100%;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
  }

  .specialty__text {
    display: grid;
    gap: var(--space-1);
  }

  .specialty__title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  .specialty__body {
    color: var(--color-ink-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .specialty :global(.specialty__arrow) {
    flex-shrink: 0;
    color: var(--color-action);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .specialty:hover .specialty__title {
    color: var(--color-action);
  }

  .specialty:hover :global(.specialty__arrow) {
    transform: translateX(4px);
  }

  .specialties__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    margin-top: var(--space-8);
  }

  @media (min-width: 48rem) {
    .specialties__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-10);
    }
  }

  @media (min-width: 64rem) {
    .specialties__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      max-width: none;
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .specialties__intro {
      padding-top: 0.5rem;
    }

    .specialties__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-12);
    }
  }
</style>
