---
/**
 * PROVISIONAL typographic wordmark. Hitec has no logo yet; replace this
 * component with the supplied vector logo when it exists.
 */
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${tone}`]}>
  <span class="wordmark__name">Hitec</span><span class="wordmark__rule" aria-hidden="true"></span><span
    class="wordmark__desc">Solutions</span
  >
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.3125rem;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark__name {
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .wordmark__rule {
    width: 1px;
    height: 1.05em;
    background: currentColor;
    opacity: 0.35;
  }

  .wordmark__desc {
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .wordmark--dark {
    color: var(--color-navy);
  }

  .wordmark--light {
    color: var(--color-on-navy);
  }
</style>
