---
/**
 * Hitech Assistant: compact chat card (avatar header, greeting, two outlined
 * choices, single-line question box, centred disclaimer), in the site palette.
 * Behaviour lives in src/scripts/assistant.ts; the data-* hooks below are its contract.
 */
import Icon from '../ui/Icon.astro';
---

<div class="assistant" data-assistant hidden>
  <div class="assistant__greeting" data-chat-greeting hidden>
    <button class="assistant__dismiss" type="button" aria-label="Dismiss greeting" data-chat-dismiss>
      <Icon name="close" size={16} />
    </button>
    <div class="assistant__identity">
      <span class="assistant__avatar" aria-hidden="true">H</span>
      <div>
        <p class="assistant__name">Hitech Assistant</p>
        <p class="assistant__role">AI Assistant</p>
      </div>
    </div>
    <p class="assistant__greeting-text">Hi, how can I help you today?</p>
    <button type="button" class="assistant__choice" data-chat-start>Start a chat</button>
  </div>

  <section
    id="hitech-assistant"
    class="assistant__panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="assistant-title"
    data-chat-panel
    hidden
  >
    <header class="assistant__header">
      <div class="assistant__identity">
        <span class="assistant__avatar" aria-hidden="true">H</span>
        <div>
          <h2 id="assistant-title" class="assistant__name">Hitech Assistant</h2>
          <p class="assistant__role">AI Assistant</p>
        </div>
      </div>
      <div class="assistant__tools">
        <button type="button" class="assistant__icon-btn" aria-label="Start new conversation" title="New chat" data-chat-reset>
          <Icon name="refresh" size={18} />
        </button>
        <button type="button" class="assistant__icon-btn" aria-label="Close Hitech Assistant" title="Close" data-chat-close>
          <Icon name="close" size={18} />
        </button>
      </div>
    </header>

    <div class="assistant__body">
      <div
        class="assistant__messages"
        role="log"
        aria-label="Conversation"
        aria-live="polite"
        aria-relevant="additions"
        tabindex="0"
        data-chat-messages
      >
      </div>
      <div class="assistant__suggestions" aria-label="Conversation starters" data-chat-suggestions>
        <button type="button" class="assistant__choice" data-chat-prompt="I need to hire IT talent">Request talent</button>
        <button type="button" class="assistant__choice" data-chat-prompt="I am looking for a job">Find a job</button>
      </div>
      <p class="assistant__status" role="status" data-chat-status></p>
    </div>

    <form class="assistant__form" data-chat-form>
      <label class="visually-hidden" for="assistant-message">Ask a question</label>
      <div class="assistant__compose">
        <textarea
          id="assistant-message"
          name="message"
          rows="1"
          maxlength="1000"
          placeholder="Ask a question"
          required
          aria-describedby="assistant-privacy"></textarea>
        <button type="submit" aria-label="Send message" data-chat-send>
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
      <p id="assistant-privacy" class="assistant__disclaimer">
        AI can make mistakes. When AI is enabled, messages are sent to Anthropic to generate a reply. Don’t share
        personal or sensitive information.
      </p>
    </form>
  </section>

  <button
    type="button"
    class="assistant__launcher"
    aria-label="Open Hitech Assistant"
    aria-expanded="false"
    aria-controls="hitech-assistant"
    data-chat-launcher
  >
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8 8 0 0 1-8 8H4l1.5-4A8 8 0 1 1 20 11Z"></path><path d="M8 10h8M8 13h5"></path></svg>
    <span>Ask Hitech</span>
  </button>
</div>

<script>
  import '../../scripts/assistant';
</script>

<style>
  .assistant {
    position: fixed;
    right: max(1.5rem, env(safe-area-inset-right));
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    z-index: 80;
    color: var(--color-ink);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .assistant [hidden],
  .assistant[hidden] {
    display: none !important;
  }

  .assistant button {
    font: inherit;
    cursor: pointer;
  }

  .assistant button:focus-visible,
  .assistant textarea:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 2px;
  }

  /* ---------- Card shell shared by the greeting and the panel ---------- */
  .assistant__greeting,
  .assistant__panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.875rem);
    background: var(--color-page);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-media);
    box-shadow: 0 16px 40px -12px rgb(19 33 46 / 0.28), 0 2px 8px rgb(19 33 46 / 0.08);
  }

  .assistant__identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .assistant__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-media);
    background: var(--color-navy);
    color: var(--color-on-navy);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1;
  }

  .assistant__name {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .assistant__role {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-ink-muted);
  }

  /* Outlined, full-width choice buttons (action blue on white). */
  .assistant__choice {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-action);
    border-radius: 4px;
    background: var(--color-page);
    color: var(--color-action);
    font-size: 0.875rem !important;
    font-weight: 500;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .assistant__choice:hover {
    background: var(--color-action);
    color: #fff;
  }

  /* ---------- Greeting teaser ---------- */
  .assistant__greeting {
    width: min(18.5rem, calc(100vw - 2rem));
    padding: 1rem;
  }

  .assistant__greeting-text {
    margin: 0.875rem 0 0.875rem;
  }

  .assistant__dismiss {
    position: absolute;
    right: 0.25rem;
    top: 0.25rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--color-ink-muted);
  }

  .assistant__dismiss:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  /* ---------- Panel ---------- */
  @keyframes assistant-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .assistant__panel:not([hidden]),
  .assistant__greeting:not([hidden]) {
    animation: assistant-in var(--dur-base) var(--ease-out);
  }

  .assistant__panel {
    display: flex;
    flex-direction: column;
    width: 22.5rem;
    max-height: min(36rem, calc(100dvh - 7rem));
    overflow: hidden;
  }

  .assistant__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.875rem 0.75rem 0.75rem 1rem;
    flex-shrink: 0;
  }

  .assistant__tools {
    display: flex;
    gap: 0.125rem;
  }

  .assistant__icon-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--color-ink-muted);
  }

  .assistant__icon-btn:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .assistant__body {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line-strong) transparent;
  }

  .assistant__messages {
    padding: 0.25rem 1rem 0;
  }

  .assistant__messages:focus-visible {
    outline-offset: -2px;
  }

  .assistant__messages :global(.chat-message) {
    margin-bottom: 0.875rem;
    overflow-wrap: anywhere;
  }

  .assistant__messages :global(.chat-message__label) {
    margin-bottom: 0.25rem;
    color: var(--color-ink-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .assistant__messages :global(.chat-message__text) {
    white-space: pre-wrap;
  }

  /* Visitor messages: right-aligned tinted bubble. Assistant replies: plain text. */
  .assistant__messages :global(.chat-message--user) {
    margin-left: 2.5rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-media);
    background: var(--color-action-tint);
  }

  .assistant__messages :global(.chat-links) {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .assistant__messages :global(.chat-links a) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-action);
    border-radius: 4px;
    color: var(--color-action);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .assistant__messages :global(.chat-links a:hover) {
    background: var(--color-action);
    color: #fff;
  }

  .assistant__suggestions {
    display: grid;
    gap: 0.5rem;
    padding: 0.125rem 1rem 0.5rem;
  }

  .assistant__status {
    padding: 0 1rem;
    color: var(--color-ink-muted);
    font-size: 0.75rem;
  }

  .assistant__status:not(:empty) {
    padding-block: 0.25rem 0.5rem;
  }

  /* ---------- Question box ---------- */
  .assistant__form {
    padding: 0.5rem 1rem 0.875rem;
    flex-shrink: 0;
  }

  .assistant__compose {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.375rem 0.375rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 4px;
    background: var(--color-page);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .assistant__compose:focus-within {
    border-color: var(--color-action);
  }

  .assistant__compose textarea {
    flex: 1;
    min-width: 0;
    min-height: 1.75rem;
    max-height: 6rem;
    padding: 0.25rem 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: 0.9375rem;
    line-height: 1.4;
    resize: none;
    caret-color: var(--color-action);
  }

  .assistant__compose textarea:focus-visible {
    outline: none;
  }

  .assistant__compose textarea::placeholder {
    color: var(--color-ink-muted);
  }

  /* Send button: quiet until there is something to send. */
  .assistant__compose button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 4px;
    background: var(--color-paper);
    color: var(--color-ink-muted);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .assistant__compose:has(textarea:not(:placeholder-shown)) button {
    border-color: var(--color-action);
    background: var(--color-action);
    color: #fff;
  }

  .assistant__compose button:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .assistant__disclaimer {
    margin-top: 0.75rem;
    color: var(--color-ink-muted);
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: center;
  }

  /* ---------- Launcher ---------- */
  .assistant__launcher {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 3.25rem;
    padding: 0.75rem 1.125rem;
    margin-left: auto;
    border: 0;
    border-radius: var(--radius-media);
    background: var(--color-navy);
    color: #fff;
    font-weight: 600 !important;
    box-shadow: 0 8px 24px rgb(19 33 46 / 0.22);
  }

  .assistant__launcher:hover {
    background: var(--color-navy-raised);
  }

  .assistant__launcher > svg {
    color: var(--color-amber, #fff);
  }

  @media (max-width: 30rem) {
    .assistant {
      right: 1rem;
      bottom: max(1rem, env(safe-area-inset-bottom));
    }

    .assistant__panel {
      width: calc(100vw - 2rem);
      max-height: calc(100dvh - 6rem);
    }

    .assistant__compose textarea {
      font-size: 1rem;
    }
  }

  @media (max-height: 34rem) {
    .assistant__panel {
      position: fixed;
      inset: 0.5rem 0.5rem 0.5rem auto;
      max-height: none;
      max-width: calc(100vw - 1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .assistant * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
