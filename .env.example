# Employer-inquiry backend (JSON POST). Leave unset for the local preview.
PUBLIC_LEAD_ENDPOINT=

# Server-only assistant settings. Never prefix these with PUBLIC_.
# Revoke any credential pasted into chat; use a new key here or in Vercel.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
CHAT_ENABLED=false
# Optional comma-separated exact origins, e.g. https://your-domain.example
CHAT_ALLOWED_ORIGINS=
